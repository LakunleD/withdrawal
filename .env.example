# Copy to .env and change the secrets: cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# JWT (HS256). Must be at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=withdrawal-service
JWT_AUDIENCE=withdrawal-api
JWT_EXPIRES_IN_SECONDS=900

# Password hashing cost factor
BCRYPT_ROUNDS=12

# Frankfurter exchange rate provider
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
EXCHANGE_RATE_TIMEOUT_MS=3000
EXCHANGE_RATE_RETRIES=1
EXCHANGE_RATE_MAX_AGE_DAYS=4

# Uncomment for hot reload in local development (see docker-compose.dev.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
